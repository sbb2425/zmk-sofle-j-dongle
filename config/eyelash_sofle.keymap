#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    zip_scroll_scaler: zip_scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        track-remainders;
    };
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <0>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

    macros {
        shift_MB3: shift_MB3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mkp MB3 &kp LEFT_SHIFT>;

            label = "SHIFT_MB3";
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&trans            &trans          &trans          &trans              &trans            &trans       &mmv MOVE_UP     &trans     &trans            &trans                  &trans            &trans             &trans
&kp TAB           &kp Q           &kp W           &kp E               &kp R             &kp T        &mmv MOVE_DOWN   &kp Y      &kp U             &kp I                   &kp O             &kp P              &kp BACKSPACE
&mt LCTRL ESCAPE  &kp A           &kp S           &kp D               &kp F             &kp G        &mmv MOVE_LEFT   &kp H      &kp J             &kp K                   &kp L             &kp SEMI           &kp ENTER
&kp LSHFT         &mt LEFT_GUI Z  &mt LEFT_ALT X  &mt LEFT_CONTROL C  &mt LEFT_SHIFT V  &kp B        &mmv MOVE_RIGHT  &kp N      &mt LEFT_SHIFT M  &mt LEFT_CONTROL COMMA  &mt LEFT_ALT DOT  &mt LEFT_GUI FSLH  &kp BACKSLASH
&kp C_MUTE        &mo 9           &kp LEFT_GUI    &mo 6               &mo 5             &kp SPACE    &mkp LCLK        &kp SPACE  &mo 6             &mo 8                   &mkp MB2          &mkp MB1
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
            display-name = "LAYER0";
            label = "Base";
        };

        Game1 {
            bindings = <
&none           &none  &none  &none         &none      &none    &mmv MOVE_UP     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp GRAVE
&kp TAB         &kp Q  &kp W  &kp E         &kp R      &kp T    &mmv MOVE_DOWN   &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &kp ESCAPE
&kp LCTRL       &kp A  &kp S  &kp D         &kp F      &kp G    &mmv MOVE_LEFT   &kp E         &kp R         &kp G         &kp C         &kp Q         &kp ENTER
&kp LEFT_SHIFT  &kp Z  &kp X  &kp C         &kp V      &kp B    &mmv MOVE_RIGHT  &kp V         &kp B         &kp Z         &kp X         &kp T         &kp F5
&kp C_MUTE      &mo 9  &mo 7  &kp LEFT_ALT  &kp SPACE  &mo 2    &mkp LCLK        &kp SPACE     &mo 4         &mkp MB1      &kp F         &kp H
            >;

            display-name = "layer1";
            sensor-bindings = <&rsr_vol &rsr_trans>;
            label = "Game1";
        };

        Game2 {
            bindings = <
&trans      &trans        &trans        &trans        &trans        &trans          &mmv MOVE_UP     &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2    &mmv MOVE_DOWN   &trans  &trans  &trans  &trans  &trans  &trans
&kp ESCAPE  &trans        &trans        &trans        &kp NUMBER_3  &kp NUMBER_4    &mmv MOVE_LEFT   &trans  &trans  &trans  &trans  &trans  &trans
&mo 3       &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_5  &kp NUMBER_6    &mmv MOVE_RIGHT  &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans          &mkp LCLK        &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "layer2";
            sensor-bindings = <&rsr_vol &rsr_trans>;
            label = "Game2";
        };

        Game3 {
            bindings = <
&trans   &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp F5   &kp Y   &kp U   &kp I   &kp O   &kp P        &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp ESC  &kp H   &kp J   &kp K   &kp L   &kp ENTER    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans   &kp N   &kp M   &trans  &trans  &kp BSPC     &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans
            >;

            label = "Game3";
        };

        Game4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp N6          &kp N7          &kp N8           &kp N9  &kp N0  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp N1          &kp N2          &kp N3           &kp N4  &kp N5  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans          &kp UP_ARROW    &trans           &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans          &trans          &trans           &trans  &trans
            >;

            label = "Game4";
        };

        NUM {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp N7  &kp N8  &kp N9  &trans    &trans  &trans  &kp N7  &kp N8  &kp N9  &trans  &trans
&trans  &trans  &kp N4  &kp N5  &kp N6  &trans    &trans  &trans  &kp N4  &kp N5  &kp N6  &trans  &trans
&trans  &trans  &kp N1  &kp N2  &kp N3  &trans    &trans  &trans  &kp N1  &kp N2  &kp N3  &trans  &trans
&trans  &trans  &trans  &kp N0  &trans  &trans    &trans  &trans  &trans  &kp N0  &trans  &trans
            >;

            label = "NUM";
        };

        SYM {
            bindings = <
&trans  &trans           &trans        &trans         &trans            &trans            &trans  &trans             &trans                &trans                 &trans        &trans     &trans
&trans  &kp GRAVE        &kp TILDE     &kp LESS_THAN  &kp GREATER_THAN  &kp CARET         &trans  &kp SQT            &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp ASTERISK  &kp PLUS   &trans
&trans  &kp AT           &kp HASH      &kp DOLLAR     &kp PERCENT       &kp AMPERSAND     &trans  &kp DOUBLE_QUOTES  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SLASH     &kp MINUS  &trans
&trans  &kp EXCLAMATION  &kp QUESTION  &kp PIPE       &kp COLON         &kp UNDERSCORE    &trans  &kp COMMA          &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp DOT       &kp EQUAL  &trans
&trans  &trans           &trans        &trans         &trans            &trans            &trans  &trans             &trans                &trans                 &trans        &trans
            >;

            label = "SYM";
        };

        NAV {
            bindings = <
&trans   &trans    &trans    &trans     &trans     &trans       &trans  &trans    &trans     &trans     &trans     &trans  &trans
&trans   &kp HOME  &kp UP    &kp END    &kp PG_DN  &kp PG_UP    &trans  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &trans  &kp DEL
&kp ESC  &kp LEFT  &kp DOWN  &kp RIGHT  &mkp MB1   &mkp MB2     &trans  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &trans  &trans
&trans   &trans    &trans    &trans     &trans     &trans       &trans  &trans    &mkp MB4   &mkp MB5   &trans     &trans  &trans
&trans   &trans    &trans    &trans     &trans     &trans       &trans  &trans    &trans     &trans     &trans     &trans
            >;

            label = "NAV";
        };

        FN {
            bindings = <
&trans  &trans  &trans   &trans   &trans   &trans    &trans  &trans  &trans          &trans          &trans          &trans           &trans
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans    &trans  &trans  &kp LA(LC(F1))  &kp LA(LC(F2))  &kp LA(LC(F3))  &kp LA(LC(F4))   &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &trans    &trans  &trans  &kp LA(LC(F5))  &kp LA(LC(F6))  &kp LA(LC(F7))  &kp LC(LA(DEL))  &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans    &trans  &trans  &trans          &trans          &trans          &trans           &trans
&trans  &trans  &trans   &trans   &trans   &trans    &trans  &trans  &trans          &trans          &trans          &trans
            >;

            label = "FN";
        };

        Media {
            bindings = <
&trans  &trans             &trans            &trans           &trans  &trans    &trans  &trans        &trans  &trans  &trans  &trans  &trans
&trans  &kp C_PREVIOUS     &kp C_PLAY_PAUSE  &kp C_NEXT       &trans  &trans    &trans  &kp C_BRI_UP  &trans  &trans  &trans  &trans  &trans
&trans  &kp C_VOLUME_DOWN  &kp C_MUTE        &kp K_VOLUME_UP  &trans  &trans    &trans  &kp C_BRI_DN  &trans  &trans  &trans  &trans  &trans
&trans  &trans             &trans            &trans           &trans  &trans    &trans  &trans        &trans  &trans  &trans  &trans  &trans
&trans  &trans             &trans            &trans           &trans  &trans    &trans  &trans        &trans  &trans  &trans  &trans
            >;

            label = "Media";
        };

        Func {
            bindings = <
&trans        &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&out OUT_BLE  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_CLR
&out OUT_USB  &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&bootloader   &trans        &trans        &trans        &to 1         &to 0           &trans  &trans  &trans  &trans  &trans  &trans  &bootloader
&trans        &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
            >;

            label = "Func";
        };
    };
};
